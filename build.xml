<?xml version="1.0" encoding="UTF-8"?>
<project name="Fluid Automation Ant Build Script" default="all" basedir=".">
	<property name="project_name" value="fluidAutomation" />
	<property name="src" location="src" />
	<property name="build" location="build/classes" />
	<property name="lib" location="lib" />
	<property name="activityOutput" location="activityOutput" />
	
	<!--<property file="build.properties"/>-->

	<target name="init" depends="clean">
		<mkdir dir="${build}" />
		<mkdir dir="${lib}" />
	</target>
	
	<target name="clean">
		<delete dir="${build}" />
		<delete dir="${activityOutput}" />
	</target>
	
	<target name="init-reports" depends="clean-reports">
		<mkdir dir="reports/${report.dir}" />
		<mkdir dir="reports/${report.dir}/raw/" />
		<mkdir dir="reports/${report.dir}/html/" />
	</target>
	
	<target name="clean-reports">
		<delete dir="reports/${report.dir}" />
	</target>
	
	<target name="compile" depends="init">
		<javac destdir="${build}" target="1.8" source="1.8" includeantruntime="no" description="compile the source code ">
			
			<src path="${auto.project}/src"/>
			<src path="${src}" />
			
			<classpath>
				<fileset dir="${auto.project}/lib">
					<include name="**/*.jar" />
				</fileset>
				<fileset dir="${lib}">
					<include name="**/*.jar" />
				</fileset>
			</classpath>

		</javac>
	</target>

	<target name="test-rail-collation">
		<java classname="auto.utils.testRail.TestRailCollator" fork="yes">
			<classpath>
				<pathelement path="${build}" />
				
				<fileset dir="${auto.project}/lib">
					<include name="**/*.jar" />
				</fileset>
				<fileset dir="${lib}">
					<include name="**/*.jar" />
				</fileset>
			</classpath>
			<sysproperty key="fluidServer" value="${fluid.server}"/>
		</java>
	</target>
	
	<target name="run-tests-test" depends="init-reports">
		<junit printsummary="yes" haltonfailure="no" showoutput="no" fork="yes" forkmode="once">
			<classpath>
				<pathelement path="${build}" />
				
				<fileset dir="${auto.project}/lib">
					<include name="**/*.jar" />
				</fileset>
				<fileset dir="${lib}">
					<include name="**/*.jar" />
				</fileset>
			</classpath>
			
			<sysproperty key="fluidServer" value="${fluid.server}"/>
			<sysproperty key="sessionType" value="${session.type}"/>
			
			<sysproperty key="userDetails" value="${userDetails}"/>
			
			<batchtest todir="reports/${report.dir}/raw/">
				<formatter classname="auto.utils.reporting.CustomFormatter" extension=".xml"/>
				<fileset dir="${src}">
					<include name="auto/test/template/JunitTemplate.java" />
				</fileset>
			</batchtest>

		</junit>
	</target>
	
	<target name="run-select-tests" depends="init-reports">
		<junit printsummary="yes" haltonfailure="no" showoutput="no" fork="yes" forkmode="once">
			<classpath>
				<pathelement path="${build}" />
				<pathelement path="${openedge.lib}"/>
				
				<fileset dir="${auto.project}/lib">
					<include name="**/*.jar" />
				</fileset>
				<fileset dir="${lib}">
					<include name="**/*.jar" />
				</fileset>
			</classpath>
			
			<sysproperty key="fluidServer" value="${fluid.server}"/>
			<sysproperty key="sessionType" value="${session.type}"/>
			<sysproperty key="testRailServer" value="${testrail}"/>
			<sysproperty key="openedge.port" value="${openedge.port}"/>
			
			<sysproperty key="testArguments" value="${testArguments}"/>
			<sysproperty key="userDetails" value="${userDetails}"/>
			
			<batchtest todir="reports/${report.dir}/raw/">
				<formatter classname="auto.utils.reporting.CustomFormatter" extension=".xml"/>
				<fileset dir="${auto.project}/src/test/java">
					<include name="${selectTests}.java" />
				</fileset>
			</batchtest>

		</junit>
	</target>

	<target name="publish">
		<junitreport todir="reports/${report.dir}">
			<fileset dir="reports/${report.dir}/raw/">
				<include name="TEST-*.xml" />
			</fileset>
			<report styledir="reportstyles" format="frames" todir="reports/${report.dir}/html/">
		        <param name="jira" expression="${jira}"/>
		        <param name="testrail" expression="${testrail}"/>
			</report>
			<report styledir="reportstyles" format="noframes" todir="reports/${report.dir}/html/">
		        <param name="jira" expression="${jira}"/>
		        <param name="testrail" expression="${testrail}"/>
			</report>
		</junitreport>
	</target>

	<target name="dependencies">
		<jar jarfile="dependencies.jar">
			<zipgroupfileset dir="${auto.project}/lib">
				<include name="**/*.jar" />
			</zipgroupfileset>
			<zipgroupfileset dir="${lib}">
				<include name="**/*.jar" />
			</zipgroupfileset>
			<!--<fileset dir="input">
				<include name="**/*.csv" />
			</fileset>
			<fileset dir="api">
				<include name="**/*" />
			</fileset>-->
		</jar>
	</target>

	<target name="fatjar" depends="compile, dependencies">
		<jar jarfile="FluidAutomation.jar" basedir="${build}">
			<manifest>
				<attribute name="Main-Class" value="auto.utils.TestRunner" />
			</manifest>
			<zipfileset src="dependencies.jar" excludes="META-INF/*.SF" />
		</jar>
		<delete file="dependencies.jar" />
	</target>
	
	<target name="progress-collation" depends="compile">
		<java classname="auto.utils.coverage.ProgressActivities" fork="true">
			<classpath>
				<pathelement path="${build}" />
				<fileset dir="${auto.project}/lib">
					<include name="**/*.jar" />
				</fileset>
				<fileset dir="${lib}">
					<include name="**/*.jar" />
				</fileset>
			</classpath>
		    <arg value="${fluid.uidefdata}"/>
		    <arg value="${sonarqube.pct}"/>
		</java>
	</target>
	
	<target name="all" depends="compile, test-rail-collation, run-select-tests, publish" />
	<target name="build-only" depends="compile, test-rail-collation" />
	<target name="select-test-only" depends="run-select-tests, publish" />
	<target name="test-only-test" depends="run-tests-test, publish" />
</project>